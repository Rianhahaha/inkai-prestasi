# Preview Environment Variables for inkai-prestasi
# Copy this to .env.local for local testing, or configure in Vercel dashboard

# ============================================
# DATABASE (Required)
# ============================================
# Use Vercel Postgres, Neon, Supabase, or any PostgreSQL provider
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://..."

# ============================================
# PAYLOAD CMS (Required)
# ============================================
# Generate a secure secret: openssl rand -base64 32
PAYLOAD_SECRET="your-super-secret-key-min-32-characters-long"

# Preview deployment URL (update after first Vercel deploy)
NEXT_PUBLIC_SERVER_URL="https://inkai-prestasi-preview.vercel.app"

# ============================================
# SUPABASE S3 STORAGE (Required for media)
# ============================================
# Create a separate bucket for preview or use a folder prefix
SUPABASE_S3_BUCKET="inkai-prestasi-preview"
SUPABASE_S3_ACCESS_KEY_ID="your-supabase-access-key"
SUPABASE_S3_SECRET_ACCESS_KEY="your-supabase-secret-key"
SUPABASE_S3_REGION="ap-southeast-1"
SUPABASE_S3_ENDPOINT="https://ap-southeast-1.supabase.co/storage/v1/s3"

# ============================================
# GOOGLE OAUTH (Optional - for auth testing)
# ============================================
# Create separate OAuth credentials for preview
# Authorized redirect URI: https://inkai-prestasi-preview.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================
# SEED CONTROL
# ============================================
# Set to "true" to run seed on build (Vercel build command)
SEED_PREVIEW="true"

# ============================================
# NODE OPTIONS
# ============================================
NODE_OPTIONS="--no-deprecation --max-old-space-size=8000"